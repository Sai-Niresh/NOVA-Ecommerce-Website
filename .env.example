# ─────────────────────────────────────────────────────────────
# NOVA E-Commerce — environment variable template
# Copy to .env for local use, or set these in the Vercel dashboard
# (Settings → Environment Variables). No real credentials here.
#
# config/database.php reads DB_* first and falls back to the
# NOVA_DB_* names below, then to the local XAMPP defaults
# (127.0.0.1 / nova_db / root / empty password) when nothing is set.
# ─────────────────────────────────────────────────────────────

# ── Database (leave empty locally to use XAMPP defaults) ──
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Legacy names still honoured by config/database.php ──
NOVA_DB_HOST=
NOVA_DB_NAME=
NOVA_DB_USER=
NOVA_DB_PASSWORD=

# ── Admin bootstrapping (optional; defaults are dev-only) ──
NOVA_ADMIN_EMAIL=
NOVA_ADMIN_PASSWORD=
